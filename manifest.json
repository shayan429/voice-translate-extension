{
  "manifest_version": 3,
  "name": "Voice Translate & Dictate",
  "version": "1.3.1",
  "description": "Speak in any of 39 languages, get live transcription and translation, hear it back, and have it typed into any webpage.",
  "permissions": ["storage", "activeTab", "tabs", "sidePanel", "webNavigation", "scripting"],
  "host_permissions": ["<all_urls>"],
  "externally_connectable": {
    "matches": [
      "https://shayan429.github.io/*",
      "http://localhost:5173/*"
    ]
  },
  "action": {
    "default_title": "Open Voice Translator"
  },
  "commands": {
    "toggle-listening": {
      "suggested_key": { "default": "Alt+Shift+V" },
      "description": "Start or stop listening (translate and insert)"
    },
    "toggle-listening-submit": {
      "suggested_key": { "default": "Alt+Shift+S" },
      "description": "Start or stop listening, then press Enter after inserting"
    },
    "undo-last": {
      "suggested_key": { "default": "Alt+Shift+Z" },
      "description": "Undo the last voice insertion"
    },
    "repeat-last": {
      "suggested_key": { "default": "Alt+Shift+R" },
      "description": "Insert the last translation again"
    },
    "cancel-processing": {
      "description": "Cancel the translation in progress"
    }
  },
  "side_panel": {
    "default_path": "sidepanel.html"
  },
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"],
      "all_frames": true,
      "run_at": "document_idle"
    }
  ],
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
